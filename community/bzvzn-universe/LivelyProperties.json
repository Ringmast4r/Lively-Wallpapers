{
    "labelInfo": {
        "type": "label",
        "value": "Info: Advanced settings (colors, detailed look & presets) are configured in config.js. Most changes marked (Restart) require reloading the wallpaper."
    },
    "labelSystem": {
        "type": "label",
        "value": "▬▬▬ SYSTEM & LAYOUT ▬▬▬"
    },
    "showDebug": {
        "type": "checkbox",
        "value": false,
        "text": "Show System Debugger Overlay"
    },
    "monitorLayout": {
        "type": "dropdown",
        "value": 0,
        "text": "Monitor Layout (Restart)",
        "items": [
            "0: Auto-Detect",
            "1: Single",
            "2: Dual (Horizontal)",
            "3: Dual (Vertical)",
            "4: Triple",
            "5: Grid 2x2",
            "6: Pyramid",
            "7: Inverted Pyramid",
            "8: Custom"
        ]
    },
    "bezelWidth": {
        "type": "slider",
        "value": 40,
        "min": 0,
        "max": 200,
        "step": 1,
        "text": "Monitor Bezel Width / Deadzone (Restart)"
    },
    "labelPerformance": {
        "type": "label",
        "value": "▬▬▬ PERFORMANCE & CUSTOM LIMITS ▬▬▬"
    },
    "performanceSetup": {
        "type": "dropdown",
        "value": 2,
        "text": "Performance Mode (Restart)",
        "items": [
            "0: Low (Laptops)",
            "1: Medium",
            "2: High (Gaming PCs)",
            "3: Extreme (Enthusiast)",
            "4: Custom (Use Inputs Below)"
        ]
    },
    "customStarCount": {
        "type": "textbox",
